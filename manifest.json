{
  "manifest_version": 2,
  "name": "Zotero Deselect",
  "version": "0.2.8",
  "description": "Brings the familiar Finder and Windows File Explorer deselection behavior to Zotero. Click empty space to clear the current selection.",
  "applications": {
    "zotero": {
      "id": "zotero-deselect@local",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*",
      "update_url": "https://raw.githubusercontent.com/cczmd/zotero-deselect/main/updates.json"
    }
  },
  "icons": {
    "48": "icon.png",
    "96": "icon@2x.png"
  },
  "homepage_url": "https://github.com/cczmd/zotero-deselect"
}
